# Lichtkammer: Beispielkonfiguration. Kopieren nach .env (Docker, Projektwurzel)
# bzw. app/.env (all-inkl). Echte Umgebungsvariablen haben Vorrang.
# Nie committen, nie auf der öffentlichen Seite ablegen.
# Auf all-inkl wird NUR app/.env gelesen; eine .env im Webroot lehnt der Admin ab.

# production oder development (development zeigt Fehlerdetails)
LK_ENV=production
# Öffentliche Adresse ohne Schrägstrich am Ende. https:// → Cookies mit __Host-Präfix und Secure;
# http:// nur für lokale Entwicklung.
LK_BASE_URL=https://lichtkammer.example.org
LK_SITE_NAME=Lichtkammer
# 1 = Testinstallation, Suchmaschinen aussperren
LK_NOINDEX=0
# 1 = hinter Reverse-Proxy, X-Forwarded-Proto vertrauen. Braucht LK_TRUSTED_PROXIES.
LK_TRUST_PROXY=0
# Adresse(n)/Netz(e) des Reverse-Proxys (Docker), getrennt durch Leerzeichen, z. B. 172.18.0.1 oder 10.0.0.5.
# Leer: X-Forwarded-For wird ignoriert.
LK_TRUSTED_PROXIES=

# --- Geheimnisse (Pflicht für den Admin; leer lassen heißt: der Admin startet nicht) ---
# Geheimschlüssel, 32 Byte Base64. Lokal erzeugen: openssl rand -base64 32
# Eine Kopie in den Passwort-Manager (getrennt von der Datenbank-Sicherung). Nie ausgeben, nie ändern ohne Plan.
LK_APP_KEY=
# Nur nach einer Schlüsselrotation: der alte Schlüssel (nur zum Entschlüsseln)
LK_APP_KEY_PREVIOUS=
# Nur für die Ersteinrichtung (mindestens 32 Zeichen): openssl rand -hex 24 . Danach die Zeile LÖSCHEN.
LK_SETUP_TOKEN=
# Nur im Notfall (Administrator ausgesperrt), mindestens 32 Zeichen: openssl rand -hex 24 . Danach LÖSCHEN.
LK_RESET_TOKEN=

# Pfade (alle optional). Standard: data/ und originals/ neben app/, media/ in public/.
# all-inkl: der FTP-Benutzer sieht nichts oberhalb des Domain-Ordners, PHP kann dort aber schreiben. Deshalb
# LK_DATA_DIR oberhalb des Webroots setzen, die App legt den Ordner beim ersten Start selbst an, z. B.
#LK_DATA_DIR=/www/htdocs/vXXXXXX/lichtkammer-data
#LK_ORIGINALS_DIR=/www/htdocs/vXXXXXX/lichtkammer-originals
#LK_MEDIA_DIR=
# Ausnahme (nicht empfohlen): Datenordner im Webroot erlauben. Der Admin zeigt dann dauerhaft eine Warnung.
#LK_ALLOW_DATA_IN_WEBROOT=0

# Sitzung und Schutz (optional, Standardwerte in Klammern)
#LK_SESSION_IDLE=1800        # Leerlauf in Sekunden (30 Minuten)
#LK_SESSION_ABSOLUTE=43200   # höchste Dauer in Sekunden (12 Stunden)
#LK_GLOBAL_BRAKE_LIMIT=20    # Hash-Prüfungen im Fenster, danach "bitte später" für alle
#LK_GLOBAL_BRAKE_WINDOW=10   # Fenster in Sekunden
#LK_SQLITE_WAL=0             # 1 = WAL-Modus, nur nach Test auf dem Ziel
