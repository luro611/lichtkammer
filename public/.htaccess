# Lichtkammer: Webserver-Regeln für Apache (all-inkl und Docker-Image).
# Fertige HTML-Dateien direkt ausliefern, sonst an index.php.
Options -Indexes -MultiViews
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On
# Authorization-Kopf an PHP durchreichen (Apache mit PHP-FPM verwirft ihn sonst; für den Sicherungsabruf, Prüfung 21 M4).
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
# HTTP -> HTTPS (all-inkl: Variable HTTPS; Docker hinter Proxy: X-Forwarded-Proto). Ausgenommen: Anfragen von localhost
# (Healthcheck, Entwicklung), /health und die Prüfung des Zertifikats (.well-known). Prüfung 21 M3.
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteCond %{REMOTE_ADDR} !^(127\.0\.0\.1|::1)$
# Docker-Test ohne HTTPS: docker/entrypoint.sh setzt LK_HTTP_OK nur, wenn LK_BASE_URL mit http:// beginnt (Anfragen kommen im Container nie von 127.0.0.1).
RewriteCond %{ENV:LK_HTTP_OK} !=1
RewriteCond %{REQUEST_URI} !^/health$
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# Nichtöffentliches nie ausliefern, auch wenn es im Webroot liegt (all-inkl).
RewriteRule ^(app|data|originals|tests|docker|deploy|import|restore)(/|$) - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule \.(env|sqlite|sqlite3|db|log|bak|sql|zip|md)$ - [F,L]
# Existierende Dateien (auch fertige Seiten) direkt, alles andere an den Router.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>
# Eigene Fehlerseiten statt des Apache-Standardtexts (der Serverkennung und Pfade nennen kann). Nur Apache-eigene
# Fehler (403 durch die Sperren oben, 500 ohne PHP-Antwort); die Seiten der App (404, Fehler) kommen von PHP.
ErrorDocument 403 /fehler.html
ErrorDocument 500 /fehler.html
ErrorDocument 503 /fehler.html
# Im Medienordner läuft kein PHP: siehe public/media/.htaccess

# Komprimieren und Zwischenspeichern: CSS/JS tragen ?v=<Änderungszeit>, Schriften ändern sich selten.
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/xml text/plain image/svg+xml
</IfModule>
<IfModule mod_headers.c>
# Auch für Dateien, die Apache selbst ausliefert (/assets, /media): kein Inhaltsraten (Prüfung 21 N1).
Header always set X-Content-Type-Options "nosniff"
<FilesMatch "\.(css|js)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.(ttf|otf|woff2?)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
</IfModule>
