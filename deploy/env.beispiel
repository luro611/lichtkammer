# Zugang für ./deploy.sh. Kopieren nach deploy/.env (nicht im Repository).
# Passwort liegt im macOS-Schlüsselbund, Dienst web-ftp-<DOMAIN>:
#   security add-generic-password -U -a <FTP_USER> -s web-ftp-<DOMAIN> -w
DOMAIN=lichtkammer.br-foto.com
FTP_HOST=
FTP_USER=

# Pflicht für --einrichten: beide Ordner OBERHALB des Webroots (FTPS sieht sie nicht, PHP legt sie an).
# Originale enthalten alle Metadaten (auch GPS) und dürfen nie im Webroot liegen.
LK_DATA_DIR=/www/htdocs/vXXXXXX/lichtkammer-data
LK_ORIGINALS_DIR=/www/htdocs/vXXXXXX/lichtkammer-originals
